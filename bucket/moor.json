{
    "version": "0.6.7",
    "description": "基于 Tauri 的现代 MCP（模型上下文协议）管理器",
    "homepage": "https://github.com/maqibg/moor",
    "license": "MIT",
    "notes": [
        "Moor is an MCP Manager for managing Model Context Protocol servers",
        "User data: <install dir>\\data\\, next to moor.exe (moved there in 0.6.7)",
        "Scoop persists that directory, so it survives updates and uninstalls",
        "Data written to %APPDATA%\\com.snowautumn.moor\\ by versions before 0.6.7 is migrated automatically on first launch"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/maqibg/moor/releases/download/v0.6.7/Moor_0.6.7_x64-setup.exe#/dl.7z",
            "hash": "6e41b377417098262c01d680928f8992a5b1d8f48f4a71ee0c2d0993f74ccee2"
        }
    },
    "pre_install": "Remove-Item \"$dir\\`$*\", \"$dir\\uninstall.exe\" -Force -Recurse -ErrorAction SilentlyContinue",
    "bin": "moor.exe",
    "shortcuts": [
        [
            "moor.exe",
            "Moor"
        ]
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/maqibg/moor"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/maqibg/moor/releases/download/v$version/Moor_$version_x64-setup.exe#/dl.7z"
            }
        }
    }
