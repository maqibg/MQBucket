{
    "version": "0.14.1",
    "description": "Local-first AI coding agent desktop: Electron + Rust host core + pi Agent Harness + user-installable plugins",
    "homepage": "https://github.com/vastsa/pi-desktop",
    "license": "LGPL-3.0-only",
    "notes": [
        "PI Desktop 是一个本地优先的 AI 编程代理桌面应用，支持用户可安装的插件系统",
        "用户数据目录：%USERPROFILE%\\.pi-desktop\\（pi.sqlite、会话、插件、日志、缓存等）",
        "本包会将该目录持久化到 Scoop 的 persist，并在原路径创建 Junction 指向 persist",
        "工作区内的 .pi 目录（计划文件等）保留在各项目内，不由本包管理",
        "应用内置自动更新（electron-updater），建议关闭以避免与 Scoop 的更新机制冲突"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/vastsa/pi-desktop/releases/download/v0.14.1/PI-Desktop-Setup-0.14.1.exe#/dl.7z",
            "hash": "24f2c0bcb625852ee491ea8b73277d410cf87ecc47a6423e9610b515fc0f5b91"
        }
    },
    "pre_install": [
        "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\" -Removal",
        "Remove-Item \"$dir\\`$*\", \"$dir\\uninstall.exe\" -Force -Recurse -ErrorAction SilentlyContinue"
    ],
    "bin": "PI-Desktop.exe",
    "shortcuts": [
        [
            "PI-Desktop.exe",
            "PI Desktop"
        ]
    ],
    "post_install": [
        "$source = Join-Path $env:USERPROFILE '.pi-desktop'",
        "$target = Join-Path $persist_dir 'data'",
        "ensure $target",
        "",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        Write-Host \"检测到已存在的联接点：$source，跳过创建\"",
        "        return",
        "    }",
        "    if (-not $item.PSIsContainer) {",
        "        throw \"配置路径已存在且不是目录：$source\"",
        "    }",
        "",
        "    & robocopy $source $target /E /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "    if ($LASTEXITCODE -gt 7) {",
        "        Write-Host \"迁移失败，保留原目录：$source\"",
        "        return",
        "    }",
        "",
        "    $backup = \"$source.backup-$(Get-Date -Format 'yyyyMMdd-HHmmss')\"",
        "    try {",
        "        Move-Item -LiteralPath $source -Destination $backup -Force",
        "        Write-Host \"已备份原配置目录：$backup\"",
        "    } catch {",
        "        Write-Host \"无法重命名原目录：$source\"",
        "        return",
        "    }",
        "}",
        "",
        "New-Item -Path $source -ItemType Junction -Value $target | Out-Null"
    ],
    "post_uninstall": [
        "$source = Join-Path $env:USERPROFILE '.pi-desktop'",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        Remove-Item -LiteralPath $source -Force",
        "    }",
        "}"
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/vastsa/pi-desktop"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/vastsa/pi-desktop/releases/download/v$version/PI-Desktop-Setup-$version.exe#/dl.7z"
            }
        }
    }
}
