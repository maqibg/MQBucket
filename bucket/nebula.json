{
    "version": "1.4.1",
    "description": "GPU-accelerated Windows terminal with resident sessions, AI CLI notifications, native SSH/SFTP, and Markdown/TeX viewing",
    "homepage": "https://github.com/Kuddev/nebula",
    "license": "GPL-3.0-or-later",
    "notes": [
        "Application data: %APPDATA%\\Nebula\\ (settings, command history, sessions, SSH profiles, sync state, and logs)",
        "This package migrates the complete data directory into Scoop persist and mounts it through a Junction",
        "Keep the ZIP layout intact; runtime\\conpty.dll, runtime\\OpenConsole.exe, and runtime\\nebula-hook.exe are required",
        "The v1.1.0 portable ZIP embeds Maple Mono in nebula.exe and no longer includes a fonts\\ directory; the app can materialize the embedded font under %APPDATA%\\Nebula\\fonts when the optional font-install prompt is used",
        "Nebula may update its own entries in Claude, Codex, opencode, and Pi configuration files; those external tool configs remain user-owned",
        "Close Nebula before installing, updating, or uninstalling this package"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/Kuddev/nebula/releases/download/v1.4.1/NebulaTerminal-v1.4.1-windows-x64.zip",
            "hash": "4ffcf7b9335863f6bc96bad1ed36471c8066bc560127a211c0dbff7e3d5fcd19"
        }
    },
    "pre_install": [
        "$running = @(Get-Process -Name 'nebula' -ErrorAction SilentlyContinue)",
        "if ($running.Count -gt 0) { throw 'Nebula is running. Close it before installing or upgrading this package.' }"
    ],
    "bin": "nebula.exe",
    "shortcuts": [
        [
            "nebula.exe",
            "Nebula Terminal"
        ]
    ],
    "post_install": [
        "$source = Join-Path $env:APPDATA 'Nebula'",
        "$target = Join-Path $persist_dir 'data'",
        "ensure $target",
        "$backup = $null",
        "$needsMount = $true",
        "",
        "if (Test-Path $source) {",
        "    $item = Get-Item -LiteralPath $source -Force",
        "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "        $expected = [IO.Path]::GetFullPath($target).TrimEnd('\\')",
        "        $actual = @($item.Target) | Select-Object -First 1",
        "        if ($actual -and [IO.Path]::GetFullPath($actual).TrimEnd('\\') -ieq $expected) {",
        "            $needsMount = $false",
        "            Write-Host \"Junction already managed by Scoop: $source\"",
        "        } else {",
        "            throw \"Path is an existing reparse point not managed by this package: $source\"",
        "        }",
        "    } elseif (-not $item.PSIsContainer) {",
        "        throw \"Path exists and is not a directory: $source\"",
        "    } else {",
        "        & robocopy.exe $source $target /E /R:1 /W:1 /NFL /NDL /NJH /NJS /NP | Out-Null",
        "        $copyExitCode = $LASTEXITCODE",
        "        if ($copyExitCode -gt 7) {",
        "            throw \"Migration failed with robocopy exit code ${copyExitCode}: $source\"",
        "        }",
        "",
        "        $backup = \"$source.backup-$(Get-Date -Format 'yyyyMMdd-HHmmssfff')\"",
        "        Move-Item -LiteralPath $source -Destination $backup",
        "        Write-Host \"Backed up original directory: $backup\"",
        "    }",
        "}",
        "",
        "if ($needsMount) {",
        "    try {",
        "        New-Item -Path $source -ItemType Junction -Value $target -Force | Out-Null",
        "    } catch {",
        "        if ($backup -and (Test-Path $backup) -and -not (Test-Path $source)) {",
        "            Move-Item -LiteralPath $backup -Destination $source",
        "        }",
        "        throw",
        "    }",
        "}"
    ],
    "uninstaller": {
        "script": [
            "$running = @(Get-Process -Name 'nebula' -ErrorAction SilentlyContinue)",
            "if ($running.Count -gt 0) { throw 'Nebula is running. Close it before uninstalling this package.' }",
            "$exe = Join-Path $dir 'nebula.exe'",
            "if (Test-Path $exe) {",
            "    & $exe setup-ai --remove | Out-Host",
            "    if ($LASTEXITCODE -ne 0) { throw \"Nebula AI integration cleanup failed with exit code $LASTEXITCODE\" }",
            "}",
            "$source = Join-Path $env:APPDATA 'Nebula'",
            "if (Test-Path $source) {",
            "    $item = Get-Item -LiteralPath $source -Force",
            "    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
            "        $target = Join-Path $persist_dir 'data'",
            "        $expected = [IO.Path]::GetFullPath($target).TrimEnd('\\')",
            "        $actual = @($item.Target) | Select-Object -First 1",
            "        if ($actual -and [IO.Path]::GetFullPath($actual).TrimEnd('\\') -ieq $expected) {",
            "            Remove-Item -LiteralPath $source -Force",
            "        }",
            "    }",
            "}"
        ]
    },
    "persist": "data",
    "checkver": {
        "github": "https://github.com/Kuddev/nebula"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Kuddev/nebula/releases/download/v$version/NebulaTerminal-v$version-windows-x64.zip"
            }
        },
        "hash": {
            "mode": "download"
        }
    }
}
